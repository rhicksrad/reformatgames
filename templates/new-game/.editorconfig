root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4

[*.{gd,tscn,tres,godot}]
indent_style = tab

[*.{py,sh}]
indent_style = space
indent_size = 4

[*.{json,yml,yaml,csproj,props}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
